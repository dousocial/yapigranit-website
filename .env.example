# --- Veritabanı ---
# Dev (SQLite): file:./prisma/dev.db
# Prod (PostgreSQL): postgresql://user:pass@host:5432/dbname?schema=public
DATABASE_URL="file:./prisma/dev.db"

# --- NextAuth ---
# 32+ bytelık random string. Üret: openssl rand -base64 32
AUTH_SECRET="please-change-me-in-production-32-bytes-min"
AUTH_TRUST_HOST="true"

# --- İlk admin (otomatik seed) ---
ADMIN_EMAIL="admin@yapigranit.com.tr"
ADMIN_PASSWORD="changeme123"

# --- E-posta (Resend) ---
# Boş bırakırsan formlar yine çalışır, sadece konsola log düşer.
# https://resend.com adresinden API key alabilirsiniz.
RESEND_API_KEY=""
RESEND_FROM="YAPIGRANİT <noreply@yapigranit.com>"
RESEND_TO="info@yapigranit.com"

# --- Google Analytics 4 ---
# Web stream Measurement ID (G-... formatında). Public — tarayıcıya gider.
NEXT_PUBLIC_GA_ID=""

# --- Google Tag Manager (opsiyonel — tag'leri merkezi yönetmek için) ---
# Container ID: GTM-XXXXXXX veya GT-XXXXXXX (yeni format)
NEXT_PUBLIC_GTM_ID=""

# --- GA4 Measurement Protocol API Secret (opsiyonel) ---
# !! SADECE SERVER-SIDE !!  Asla NEXT_PUBLIC_ ile başlatma — tarayıcıya gitmez.
# Server-side conversion event'leri (form submit'ler, e-ticaret) göndermek için.
# Şu anki uygulamada kullanılmıyor; ileride form-to-GA4 eventi için lazım olabilir.
GA_MEASUREMENT_PROTOCOL_SECRET=""

# --- Meta Pixel (Facebook/Instagram reklamları için, opsiyonel) ---
# 15-16 haneli sayı. Reklam yapacaksan business.facebook.com'dan alırsın.
NEXT_PUBLIC_META_PIXEL_ID=""
