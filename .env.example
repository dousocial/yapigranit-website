# --- Veritabanı ---
# Dev (SQLite): file:./prisma/dev.db
# Prod (PostgreSQL): postgresql://user:pass@host:5432/dbname?schema=public
DATABASE_URL="file:./prisma/dev.db"

# --- NextAuth ---
# 32+ bytelık random string. Üret: openssl rand -base64 32
AUTH_SECRET="please-change-me-in-production-32-bytes-min"
AUTH_TRUST_HOST="true"

# --- İlk admin (otomatik seed) ---
ADMIN_EMAIL="admin@yapigranit.com.tr"
ADMIN_PASSWORD="changeme123"

# --- E-posta (Resend) ---
# Boş bırakırsan formlar yine çalışır, sadece konsola log düşer.
# https://resend.com adresinden API key alabilirsiniz.
RESEND_API_KEY=""
RESEND_FROM="Yapı Granit <noreply@yapigranit.com.tr>"
RESEND_TO="info@yapigranit.com.tr"

# --- Analytics (opsiyonel) ---
# NEXT_PUBLIC_ ön ekiyle başlayan değişkenler tarayıcıya gönderilir.
# Hepsi opsiyonel; boş bırakırsan o servis yüklenmez.
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
